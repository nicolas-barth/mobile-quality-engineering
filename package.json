{
  "name": "mobile-quality-engineering",
  "version": "0.1.0",
  "description": "Mobile quality engineering initiative built against the Sauce Labs My Demo App Android to assess production release readiness.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.8.0",
  "type": "commonjs",
  "scripts": {
    "setup": "npm ci && husky",
    "validate": "npm run lint && npm run format:check && npm run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "appium:install-driver": "bash scripts/install-appium-driver.sh",
    "appium:start": "bash scripts/start-appium.sh",
    "app:prepare": "bash scripts/prepare-android-app.sh",
    "app:reset": "bash scripts/reset-application.sh",
    "app:install": "adb install -r \"${ANDROID_APP_PATH:-./app/android/mda-2.2.0-25.apk}\"",
    "app:uninstall": "adb uninstall \"${ANDROID_APP_PACKAGE:-com.saucelabs.mydemoapp.android}\"",
    "env:check": "bash scripts/check-environment.sh",
    "device:info": "bash scripts/device-info.sh",
    "device:permissions:reset": "adb shell pm reset-permissions -p \"${ANDROID_APP_PACKAGE:-com.saucelabs.mydemoapp.android}\"",
    "test:smoke": "wdio run wdio.conf.ts --suite smoke",
    "test:smoke:local": "bash scripts/run-smoke.sh",
    "test:functional": "wdio run wdio.conf.ts --suite functional",
    "test:critical": "wdio run wdio.conf.ts --suite critical",
    "test:device": "wdio run wdio.conf.ts --suite device",
    "test:permissions": "wdio run wdio.conf.ts --suite permissions",
    "test:checkout": "wdio run wdio.conf.ts --suite checkout",
    "test:regression": "wdio run wdio.conf.ts --suite regression",
    "test:regression:local": "bash scripts/run-regression.sh",
    "test:real-device": "wdio run wdio.conf.ts --suite device --mochaOpts.grep @real-device",
    "test:emulator": "wdio run wdio.conf.ts --suite regression --mochaOpts.grep @real-device --mochaOpts.invert",
    "test:repeat:smoke": "bash scripts/repeat-smoke.sh",
    "test:accessibility": "wdio run wdio.conf.ts --suite accessibility",
    "test:visual": "wdio run wdio.conf.ts --suite visual",
    "test:installation": "wdio run wdio.conf.ts --suite installation",
    "test:upgrade": "wdio run wdio.conf.ts --suite upgrade",
    "test:compatibility": "wdio run wdio.compatibility.conf.ts",
    "test:mobile-web": "wdio run wdio.mobileweb.conf.ts",
    "test:security": "wdio run wdio.conf.ts --suite security",
    "test:stability": "wdio run wdio.conf.ts --suite stability",
    "test:advanced": "wdio run wdio.conf.ts --suite advanced",
    "stability:repeat": "bash scripts/stability-repeat.sh",
    "stability:monkey": "tsx scripts/run-monkey.ts",
    "performance:startup": "wdio run wdio.conf.ts --suite performance",
    "security:scan": "tsx scripts/security-scan.ts",
    "report:generate": "allure generate allure-results --clean -o reports/allure-report",
    "report:open": "allure open reports/allure-report",
    "report:serve": "allure serve allure-results",
    "report:clean": "rimraf allure-results reports/allure-report",
    "ci:pull-request": "bash scripts/validate-project.sh",
    "quality:collect": "tsx scripts/quality.ts collect",
    "quality:normalize": "tsx scripts/quality.ts normalize",
    "quality:metrics": "tsx scripts/quality.ts metrics",
    "quality:gates": "tsx scripts/quality.ts gates",
    "quality:score": "tsx scripts/quality.ts score",
    "quality:report": "tsx scripts/quality.ts report",
    "quality:release": "tsx scripts/quality.ts release",
    "quality:demo": "tsx scripts/quality.ts demo",
    "quality:history": "tsx scripts/quality.ts history",
    "quality:trend": "tsx scripts/quality.ts trend",
    "quality:test": "vitest run src/quality",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@wdio/allure-reporter": "9.30.1",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/junit-reporter": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/types": "9.30.1",
    "@wdio/visual-service": "^10.1.0",
    "allure-commandline": "2.43.0",
    "appium": "3.6.0",
    "appium-uiautomator2-driver": "8.2.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tsx": "4.23.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "webdriverio": "9.30.1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "dotenv": "16.6.1",
    "pino": "9.14.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.1",
    "deepmerge-ts": "^8.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
